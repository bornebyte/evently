# Neon / Prisma
DATABASE_URL="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/evently?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/evently?sslmode=require"

# Gmail SMTP (use an app password, never a personal password)
GMAIL_USER="hello@example.com"
GMAIL_APP_PASSWORD="replace-with-gmail-app-password"

# Used for canonical links in ticket confirmation emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Initial admin seed (used by npm run db:seed)
INITIAL_ADMIN_EMAIL="admin@evently.com"
INITIAL_ADMIN_PASSWORD="admin"
